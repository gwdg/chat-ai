# Production image: Vite builds the static bundle, nginx serves it.
# secrets/front.json is baked into the bundle at build time, so rebuild after changing it.
# Needs the build context "config" pointing at the secrets directory, e.g.
#   docker build --build-context config=../secrets -f Dockerfile.prod .
# (docker-compose.prod.yml sets this up).

FROM docker.io/library/node:24-alpine AS build

WORKDIR /usr/src/app

# Install exactly what package-lock.json pins; fails if it is out of sync with package.json
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# COPY (unlike a secret mount) is part of the cache key, so a changed front.json triggers a rebuild
COPY --from=config front.json /config/front.json
ENV CONFIG_LOCATION=/config/front.json

RUN npm run build


FROM docker.io/library/nginx:stable-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /usr/src/app/dist /usr/share/nginx/html

EXPOSE 8080
