    "default": {
        "model": {
            "id": "deepseek-v4.1-flash-1017",
            "name": "deepseek-v4.1-flash-1017"
        },
        "messages": [
            {"role": "system","content":"You are a helpful assistant"}
        ],
        "top_p": 0.5,
        "temperature": 0.5
