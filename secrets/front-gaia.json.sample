        "render_chartjs": false,
        "collapse_reasoning_while_streaming": true,
        "document_conversion_mode": "choice",
        "conversation_summaries": true,
        "show_timestamps": false,
        "advanced_mode": false,
        "send_with_enter": null,
        "mcp_tool_policy": "ask",
        "timeout": 300000
    },
